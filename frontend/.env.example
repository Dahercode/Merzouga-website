BOOKING_MAIL_TO=you@example.com

# Local SMTP (MailDev)
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Merzouga Tours <no-reply@merzouga.local>"

# TripAdvisor Content API — reviews on the homepage.
# Leave empty to keep the static rating from src/content/reassurance/*.mdx.
# Read at build time only, so the key is never shipped to the browser.
# Location ID is the digits after "-d" in the TripAdvisor URL.
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=34516267
