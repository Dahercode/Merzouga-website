---
import { Container } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import { frontmatter as enFrontmatter } from '../../../content/reassurance/en.mdx';
import { frontmatter as esFrontmatter } from '../../../content/reassurance/es.mdx';
import { frontmatter as frFrontmatter } from '../../../content/reassurance/fr.mdx';

interface Props {
  locale?: 'en' | 'es' | 'fr';
}

const { locale = 'en' } = Astro.props as Props;

const frontmatterByLocale = {
  en: enFrontmatter,
  es: esFrontmatter,
  fr: frFrontmatter,
} satisfies Record<string, typeof enFrontmatter>;

const frontmatter = frontmatterByLocale[locale] ?? enFrontmatter;
const { title, rating, tripadvisor } = frontmatter;

const ratingValue = rating?.value || '';
const STARS = Array.from({ length: 5 });

/* TripAdvisor's free "ratings only" widget: logo, bubble rating and live
   review count, linking to the listing. It replaces the contents of its
   container on load, so the logo link inside is the fallback when the script
   is blocked. Its ID must stay TA_<wtype><uniq>. */
const WIDGET_TYPE = 'cdsratingsonlynarrow';
const WIDGET_UNIQ = '704';
const WIDGET_LANG = { en: 'en_US', fr: 'fr', es: 'es' }[locale];
const TA_HOME = {
  en: 'https://www.tripadvisor.com/',
  fr: 'https://www.tripadvisor.fr/',
  es: 'https://www.tripadvisor.es/',
}[locale];
const widgetSrc =
  `https://www.jscache.com/wejs?wtype=${WIDGET_TYPE}&uniq=${WIDGET_UNIQ}` +
  `&locationId=${tripadvisor?.locationId}&lang=${WIDGET_LANG}` +
  `&border=false&shadow=false&backgroundColor=white&display_version=2`;
---

<Container>
  <section class="reassurance" aria-label={title}>
    <p class="score">
      <span data-score>{ratingValue}</span><span class="score__max">/5</span>
    </p>

    <div class="summary">
      <p class="summary__title">{title}</p>
      <div class="summary__rating">
        <span class="summary__stars" role="img" aria-label={`${ratingValue} / 5`}>
          {STARS.map(() => <Icon name="ic:round-star" />)}
        </span>
        <span class="summary__label">{tripadvisor?.scoreLabel}</span>
      </div>
      <a
        class="summary__link"
        href={tripadvisor?.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {tripadvisor?.seeMoreLabel}
        <Icon name="ic:round-arrow-forward" aria-hidden="true" />
      </a>
    </div>

    <div class="proof">
      <div class="badge">
        <div
          id={`TA_${WIDGET_TYPE}${WIDGET_UNIQ}`}
          class={`TA_${WIDGET_TYPE}`}
          data-ta-widget
        >
          <ul class="TA_links">
            <li>
              <a target="_blank" rel="noopener" href={TA_HOME}>
                <img
                  src="https://www.tripadvisor.com/img/cdsi/img2/branding/v2/Tripadvisor_lockup_horizontal_secondary-11900-2.svg"
                  alt="Tripadvisor"
                  width="120"
                  height="27"
                />
              </a>
            </li>
          </ul>
        </div>
      </div>
      <script is:inline async src={widgetSrc}></script>
    </div>
  </section>
</Container>

<script>
  /* Keep the big score (and the stars' label) in step with the widget, whose
     bubble class encodes the live rating (bubble_45 = 4.5). The content file
     value is the fallback. */
  document.querySelectorAll<HTMLElement>('[data-ta-widget]').forEach((widget) => {
    const section = widget.closest('.reassurance');
    const score = section?.querySelector<HTMLElement>('[data-score]');
    const stars = section?.querySelector<HTMLElement>('.summary__stars');
    if (!score) return;

    const sync = () => {
      const bubble = widget.querySelector('.ui_bubble_rating');
      const match = bubble?.className.match(/bubble_(\d)(\d)/);
      if (!match) return false;
      const value = `${match[1]}.${match[2]}`;
      score.textContent = value;
      stars?.setAttribute('aria-label', `${value} / 5`);
      return true;
    };

    if (sync()) return;
    const observer = new MutationObserver(() => {
      if (sync()) observer.disconnect();
    });
    observer.observe(widget, { childList: true, subtree: true });
  });
</script>

<style>
  /* Solid theme colour, the score as the focal point, then the TripAdvisor
     badge as proof. Space does the separating; there are no rules. The booking
     button lives in BookTourButton.astro, floating on the homepage. */
  .reassurance {
    --r-bg: var(--theme-primary);
    --r-ink: var(--theme-on-primary);
    --r-soft: color-mix(in srgb, var(--r-ink) 80%, transparent);
    /* TripAdvisor's ink colour, so the badge text matches its logo. */
    --ta-ink: #002b11;

    margin: var(--section-margin) auto;
    max-width: 1280px;
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'score summary proof';
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 2.75rem);
    row-gap: 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.5rem) clamp(1.75rem, 4vw, 3.5rem);
    background: var(--r-bg);
    color: var(--r-ink);
    border-radius: var(--theme-shape-radius);
    box-shadow: 0 18px 45px color-mix(in srgb, var(--r-bg) 22%, transparent);
  }

  /* ---------- Score ---------- */

  .score {
    grid-area: score;
    margin: 0;
    font-family: var(--theme-font-family-serif);
    font-size: clamp(3.5rem, 6.5vw, 4.75rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .score__max {
    margin-left: 0.1em;
    font-size: 0.32em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--r-soft);
  }

  /* ---------- Summary ---------- */

  .summary {
    grid-area: summary;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    min-width: 0;
  }

  .summary__title {
    margin: 0;
    font-family: var(--theme-font-family-serif);
    font-size: clamp(1.25rem, 2.1vw, 1.55rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .summary__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.95rem;
    color: var(--r-soft);
  }

  .summary__stars {
    display: inline-flex;
    gap: 0.05rem;
    color: var(--r-ink);
  }

  .summary__stars :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .summary__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    color: var(--r-ink);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--r-ink) 45%, transparent);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--theme-transition);
  }

  .summary__link :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--theme-transition);
  }

  .summary__link:hover,
  .summary__link:focus-visible {
    text-decoration-color: var(--r-ink);
  }

  .summary__link:hover :global(svg),
  .summary__link:focus-visible :global(svg) {
    transform: translateX(3px);
  }

  /* ---------- TripAdvisor badge ---------- */

  .proof {
    grid-area: proof;
  }

  .badge {
    min-width: 11.5rem;
    min-height: 5.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    background: #fff;
    color: var(--ta-ink);
    border-radius: min(var(--theme-shape-radius), 1.1rem);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.14);
  }

  /* The widget injects TripAdvisor's own markup and stylesheet. Reflow it
     into a compact badge (logo, then bubbles and review count) and drop the
     business name, which repeats what the page already says. */
  .badge :global(.TA_links) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .badge :global(.TA_links img) {
    display: block;
    width: 128px;
    height: auto;
  }

  .badge :global(.cdsROW) {
    width: auto !important;
    margin: 0;
    padding: 0 !important;
    border: none;
    box-shadow: none;
    background: transparent !important;
    font-family: var(--theme-font-family-sans);
  }

  .badge :global(.cdsROW a) {
    text-decoration: none;
  }

  .badge :global(.cdsROWContainer) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .badge :global(.cdsLocName) {
    display: none;
  }

  .badge :global(.cdsROW .logo) {
    order: -1;
    padding: 0;
    background: none;
    border: none;
  }

  .badge :global(.cdsROW .logo img) {
    display: block;
    width: 128px;
    max-width: none;
    padding: 0;
  }

  .badge :global(.cdsROW .cdsRating) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1;
    color: var(--ta-ink);
  }

  .badge :global(.cdsROW .cdsRating br) {
    display: none;
  }

  .badge :global(.cdsROW .ui_bubble_rating) {
    font-size: 1rem;
  }

  /* ---------- Responsive ---------- */

  /* Phone and small tablet: one centred column. */
  @media (max-width: 720px) {
    .reassurance {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'score'
        'summary'
        'proof';
      justify-items: center;
      row-gap: 1.25rem;
      text-align: center;
    }

    .summary {
      align-items: center;
    }

    .summary__rating {
      justify-content: center;
    }
  }
</style>
