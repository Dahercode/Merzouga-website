---
import { Container } from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import { localizePath } from 'astro-i18next';
import { getTripAdvisorData } from '../../../lib/tripadvisor';
import { frontmatter as enFrontmatter } from '../../../content/reassurance/en.mdx';
import { frontmatter as esFrontmatter } from '../../../content/reassurance/es.mdx';
import { frontmatter as frFrontmatter } from '../../../content/reassurance/fr.mdx';

interface Props {
  locale?: 'en' | 'es' | 'fr';
}

const { locale = 'en' } = Astro.props as Props;

const frontmatterByLocale = {
  en: enFrontmatter,
  es: esFrontmatter,
  fr: frFrontmatter,
} satisfies Record<string, typeof enFrontmatter>;

const frontmatter = frontmatterByLocale[locale] ?? enFrontmatter;
const { title, rating, tripadvisor, reviews = [], cta } = frontmatter;

/* Null until TRIPADVISOR_API_KEY + TRIPADVISOR_LOCATION_ID are set, at which
   point the live rating and latest reviews take over automatically. */
const live = await getTripAdvisorData(locale);

const displayedReviews = live?.reviews?.length ? live.reviews : reviews;
const ratingValue = live?.rating || rating?.value || '';
const reviewCount = live?.reviewCount || rating?.count || 0;
const reviewsUrl = live?.webUrl || tripadvisor?.url;

const hasReviews = displayedReviews.length > 0;
const countLabel = (hasReviews
  ? tripadvisor?.latestReviewsLabel
  : tripadvisor?.totalReviewsLabel
)?.replace('{count}', String(hasReviews ? displayedReviews.length : reviewCount));

const watermark = ratingValue.split('.')[0];
const STARS = Array.from({ length: 5 });

const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
---

<Container>
  <section class:list={['reassurance', { 'reassurance--empty': !hasReviews }]}>
    <div class="panel">
      <span class="panel__watermark" aria-hidden="true">{watermark}</span>

      <p class="panel__title">{title}</p>

      <p class="panel__score">{ratingValue}</p>

      <div class="panel__stars" role="img" aria-label={`${ratingValue} / 5`}>
        {STARS.map(() => <Icon name="ic:round-star" />)}
      </div>

      <p class="panel__meta">
        <span>{countLabel}</span>
        <span class="panel__separator" aria-hidden="true">·</span>
        <span>{tripadvisor?.poweredBy}</span>
      </p>

      {
        reviewsUrl && (
          <a
            class="panel__link"
            href={reviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {tripadvisor?.seeMoreLabel}
          </a>
        )
      }
    </div>

    {
      hasReviews && (
        <ol class="reviews">
          {displayedReviews.map((review, index) => (
            <li class="review">
              <span class="review__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="review__avatar" aria-hidden="true">
                {initialsOf(review.name)}
              </span>
              <div class="review__who">
                <p class="review__name">{review.name}</p>
                {review.location && (
                  <p class="review__location">{review.location}</p>
                )}
              </div>
              <div
                class="review__stars"
                role="img"
                aria-label={`${review.rating ?? 5} / 5`}
              >
                {Array.from({ length: Math.round(review.rating ?? 5) }).map(
                  () => (
                    <Icon name="ic:round-star" />
                  )
                )}
              </div>
              <blockquote class="review__quote">{review.quote}</blockquote>
            </li>
          ))}
        </ol>
      )
    }

    <div class="cta">
      <a class="cta__button" href={localizePath('/tours')}>
        {cta?.buttonLabel}
      </a>
    </div>
  </section>
</Container>

<style>
  /* Colours resolve from the active Odyssey theme so `classic` and `sand` stay
     in sync with theme.css. In `sand` these land on the mockup's palette:
     panel = #aa6400, avatars = #6a4d34, text = #5e4536. */
  .reassurance {
    --r-panel: var(--theme-primary);
    --r-on-panel: var(--theme-on-primary);
    --r-list: var(--theme-bg);
    --r-on-list: var(--theme-on-bg);
    /* Derived from the panel rather than --theme-surface-2, whose value is an
       unrelated mint green in themes that leave it at the :root default. */
    --r-avatar: color-mix(in srgb, var(--r-panel) 80%, #000);
    --r-on-avatar: var(--r-on-panel);
    --r-muted: color-mix(in srgb, var(--r-on-list) 65%, transparent);
    --r-rule: color-mix(in srgb, var(--r-on-list) 14%, transparent);

    margin: var(--section-margin) auto;
    display: grid;
    grid-template-columns: minmax(15rem, 30%) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'panel reviews'
      'cta   reviews';
    border-radius: var(--theme-shape-radius);
    overflow: hidden;
    background: var(--r-list);
    box-shadow: 0 18px 45px color-mix(in srgb, var(--r-on-list) 12%, transparent);
    max-width: 1280px;
    width: 100%;
  }

  /* Without reviews the panel is the whole component. */
  .reassurance--empty {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'panel'
      'cta';
  }

  /* ---------- Left panel ---------- */

  .panel {
    grid-area: panel;
    position: relative;
    overflow: hidden;
    background: var(--r-panel);
    color: var(--r-on-panel);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
  }

  .panel__watermark {
    position: absolute;
    top: -0.35em;
    right: 0.1em;
    font-family: var(--theme-font-family-serif);
    font-size: clamp(9rem, 16vw, 13rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--r-on-panel) 13%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .panel__title {
    margin: 0;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .panel__score {
    margin: 0;
    position: relative;
    font-family: var(--theme-font-family-serif);
    font-size: clamp(2.5rem, 5.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
  }

  .panel__stars {
    position: relative;
    display: flex;
    gap: 0.1rem;
    color: var(--r-on-panel);
  }

  .panel__stars :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .panel__meta {
    margin: 0.35rem 0 0;
    position: relative;
    font-size: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--r-on-panel) 88%, transparent);
  }

  /* Stacked in the narrow desktop column; inline whenever the panel is wide
     (mobile, or desktop with no reviews beside it). */
  .panel__separator {
    display: none;
  }

  .reassurance--empty .panel__separator {
    display: inline;
  }

  .panel__link {
    position: relative;
    margin-top: 0.5rem;
    align-self: flex-start;
    color: var(--r-on-panel);
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    transition: opacity var(--theme-transition);
  }

  .panel__link:hover,
  .panel__link:focus-visible {
    opacity: 0.78;
  }

  /* ---------- Reviews ---------- */

  .reviews {
    grid-area: reviews;
    list-style: none;
    margin: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--r-list);
    color: var(--r-on-list);
    display: flex;
    flex-direction: column;
  }

  .review {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      'num avatar who   stars'
      'num avatar quote quote';
    align-items: start;
    column-gap: clamp(0.75rem, 1.5vw, 1.25rem);
    row-gap: 0.5rem;
    padding: clamp(1rem, 2vw, 1.5rem) 0;
  }

  .review + .review {
    border-top: 1px solid var(--r-rule);
  }

  .review__number {
    grid-area: num;
    font-family: var(--theme-font-family-serif);
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    font-weight: 700;
    color: var(--r-panel);
    line-height: 1.2;
  }

  .review__avatar {
    grid-area: avatar;
    width: clamp(2.4rem, 3.5vw, 2.9rem);
    height: clamp(2.4rem, 3.5vw, 2.9rem);
    border-radius: 50%;
    background: var(--r-avatar);
    color: var(--r-on-avatar);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--theme-font-family-serif);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .review__who {
    grid-area: who;
    min-width: 0;
  }

  .review__name {
    margin: 0;
    font-family: var(--theme-font-family-serif);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.3;
  }

  .review__location {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    color: var(--r-muted);
  }

  .review__stars {
    grid-area: stars;
    display: flex;
    gap: 0.05rem;
    color: var(--r-panel);
  }

  .review__stars :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .review__quote {
    grid-area: quote;
    margin: 0;
    padding: 0;
    border: none;
    font-family: var(--theme-font-family-serif);
    font-style: italic;
    font-size: clamp(0.925rem, 1.3vw, 1rem);
    line-height: 1.55;
    color: var(--r-on-list);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- CTA ---------- */

  .cta {
    grid-area: cta;
    background: var(--r-panel);
    padding: 0 clamp(1.75rem, 3.5vw, 2.75rem)
      clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .cta__button {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.9rem 1.5rem;
    border-radius: var(--theme-button-border-radius);
    background: var(--r-on-panel);
    color: var(--r-panel);
    font-family: var(--theme-font-family-serif);
    font-weight: 700;
    text-decoration: none;
    transition: opacity var(--theme-transition);
  }

  .cta__button:hover,
  .cta__button:focus-visible {
    opacity: 0.88;
  }

  /* The panel spans the full width when there are no reviews, so keep the
     button from stretching across it. */
  .reassurance--empty .cta__button {
    max-width: 20rem;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 900px) {
    .reassurance,
    .reassurance--empty {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      grid-template-areas:
        'panel'
        'reviews'
        'cta';
    }

    .panel {
      align-items: center;
      text-align: center;
      gap: 0.5rem;
    }

    .panel__meta {
      justify-content: center;
    }

    .panel__separator {
      display: inline;
    }

    .panel__link {
      align-self: center;
    }

    /* With reviews, the CTA drops below them onto the list background and
       inverts. With no reviews there is nothing to separate it from the panel,
       so it stays part of the panel (otherwise the button would be white on
       a white background). */
    .reassurance:not(.reassurance--empty) .cta {
      background: var(--r-list);
      padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2rem);
    }

    .reassurance:not(.reassurance--empty) .cta__button {
      background: var(--r-panel);
      color: var(--r-on-panel);
    }

    .reassurance--empty .cta__button {
      max-width: none;
    }

    .reviews {
      padding-bottom: clamp(0.5rem, 2vw, 1rem);
    }
  }

  @media (max-width: 480px) {
    .review {
      column-gap: 0.6rem;
    }

    .review__stars :global(svg) {
      width: 0.9rem;
      height: 0.9rem;
    }
  }
</style>
